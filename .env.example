# Kept only as a record of which keys the app reads.
#
# .env is no longer a bundled Flutter asset — it used to be, which meant the
# key travelled inside every IPA and APK. Pass these per build instead:
#
#   flutter run --dart-define=HELIUS_API_KEY=... --dart-define=JUPITER_API_KEY=...
#
# A local .env is still read as a fallback if a build happens to bundle one,
# so an existing development setup keeps working.

HELIUS_API_KEY=your_helius_api_key_here
JUPITER_API_KEY=your_jupiter_api_key_here
