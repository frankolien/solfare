      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "ALREADY IN THE TREE\npinenacl 0.6.0 arrives transitively via the\nsolana package and gives Curve25519 +\nXSalsa20 + Poly1305 \u2014 the same construction\nthe established iOS wallet schemes use.\n\nNo new dependency. No custom crypto.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el0156",
      "originalText": "ALREADY IN THE TREE\npinenacl 0.6.0 arrives transitively via the\nsolana package and gives Curve25519 +\nXSalsa20 + Poly1305 \u2014 the same construction\nthe established iOS wallet schemes use.\n\nNo new dependency. No custom crypto.",
      "autoResize": false,
      "lineHeight": 1.25
    },
