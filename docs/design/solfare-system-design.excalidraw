      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "ONE APPROVAL SURFACE, ONE SENDER\nSend, swap, stake, Solana Pay and dApp Connect all end at the same TxPreviewSheet,\nfed by the same TxPreview. TransactionService stays the only code that broadcasts.\nFour confirm screens would mean four places for a drainer to find a gap.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el0048",
      "originalText": "ONE APPROVAL SURFACE, ONE SENDER\nSend, swap, stake, Solana Pay and dApp Connect all end at the same TxPreviewSheet,\nfed by the same TxPreview. TransactionService stays the only code that broadcasts.\nFour confirm screens would mean four places for a drainer to find a gap.",
      "autoResize": false,
      "lineHeight": 1.25
    },
