      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "iOS has no Mobile Wallet Adapter. This is the deeplink equivalent.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "iOS has no Mobile Wallet Adapter. This is the deeplink equivalent.",
