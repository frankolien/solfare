      "boundElements": [],
      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "WHY NOT MWA\nMWA's association step is built on Android intents plus a local WebSocket.\nThere is no sanctioned iOS path. This scheme is Solfare's own until a dapp\nadopts it \u2014 a distribution problem, not a code problem. Say so plainly.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el0132",
      "originalText": "WHY NOT MWA\nMWA's association step is built on Android intents plus a local WebSocket.\nThere is no sanctioned iOS path. This scheme is Solfare's own until a dapp\nadopts it \u2014 a distribution problem, not a code problem. Say so plainly.",
      "autoResize": false,
      "lineHeight": 1.25
    },
