      "updated": 1735689600000,
      "link": null,
      "locked": false,
      "text": "WHY transferChecked AND NOT transfer\ntransferChecked verifies decimals on chain, which turns a decimals mistake into a\nrejected transaction instead of a 1000x transfer.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el0128",
      "originalText": "WHY transferChecked AND NOT transfer\ntransferChecked verifies decimals on chain, which turns a decimals mistake into a\nrejected transaction instead of a 1000x transfer.",
      "autoResize": false,
      "lineHeight": 1.25
    },
